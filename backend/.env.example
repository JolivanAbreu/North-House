# Copie este arquivo para ".env" e preencha com os seus dados.

# Banco de Dados (MariaDB/MySQL)
DB_NAME=sgv_mei_db
DB_PASS=123456
DB_USER=root
DB_HOST=127.0.0.1
DB_PORT=3306

# Autenticação (use uma string longa e aleatória em produção)
JWT_SECRET=sua_chave_secreta_super_forte_aqui

# Servidor
PORT=3001

# Frontend (usado para montar o link de redefinição de senha nos e-mails)
FRONTEND_URL=http://localhost:5173

# --- Recursos opcionais (o sistema funciona sem preencher nada abaixo) ---

# E-mail para "esqueci minha senha". Sem isso, o link aparece só no
# console do backend (útil para testar localmente).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=nao-responda@sgvmei.com

# Pix real via Mercado Pago. Sem isso, o QR code exibido ao cliente
# continua sendo o ilustrativo (não gera cobrança de verdade).
# Gere o token em: https://www.mercadopago.com.br/developers/panel
MP_ACCESS_TOKEN=

# Notificações push reais (PWA). Sem isso, o botão "Ativar notificações"
# no painel simplesmente não aparece.
# Gere as chaves com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@sgvmei.com
